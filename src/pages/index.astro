---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <form role="search" aria-label="Search games" class="mb-6" data-testid="game-search-form">
            <label for="game-search" class="block text-sm font-medium text-slate-200 mb-2">
              Search games by title
            </label>
            <input
              id="game-search"
              name="q"
              type="search"
              placeholder="Search games..."
              class="w-full rounded-lg border border-slate-600 bg-slate-800 px-4 py-3 text-slate-100 placeholder:text-slate-400 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="game-search-input"
            />
          </form>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>

          <div hidden role="status" aria-live="polite" data-testid="search-empty-state">
            <EmptyState text="No games match your search." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  import { matchesGameTitle } from '../lib/game-search';

  const searchForm = document.querySelector<HTMLFormElement>('[data-testid="game-search-form"]');
  const searchInput = document.querySelector<HTMLInputElement>('[data-testid="game-search-input"]');
  const gameCards = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-testid="game-card"]'));
  const emptyState = document.querySelector<HTMLElement>('[data-testid="search-empty-state"]');

  if (searchForm && searchInput && emptyState) {
    const updateResults = (): void => {
      let visibleGameCount = 0;

      for (const card of gameCards) {
        const matches = matchesGameTitle(card.dataset.gameTitle ?? '', searchInput.value);
        card.hidden = !matches;
        if (matches) visibleGameCount += 1;
      }

      emptyState.hidden = visibleGameCount > 0;
    };

    searchInput.addEventListener('input', updateResults);
    searchForm.addEventListener('submit', (event: SubmitEvent) => {
      event.preventDefault();
      updateResults();
    });
  }
</script>
